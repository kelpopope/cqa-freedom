# Скопируйте в .env и заполните. .env в git не коммитится.

# Ключ OpenAI (у Абуки)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Адрес API организаторов БЕЗ параметра group_id (кнопка «Открыть GET для DEV», стр. 3 гайда).
# Бэкенд сам добавит &group_id=DEV или контрольное значение из интерфейса.
ORG_API_URL=

# База данных
DB_PATH=cqa.db

# Оценка (необязательно — есть значения по умолчанию)
# gpt-6.1-sol не поддерживает temperature; глубина рассуждения: low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=medium
# Одновременных запросов к OpenAI при пакетной оценке
LLM_CONCURRENCY=6
# Цены для расчёта стоимости оценки, $ за 1 млн токенов
OPENAI_PRICE_INPUT_PER_1M=2.0
OPENAI_PRICE_CACHED_PER_1M=0.10
OPENAI_PRICE_OUTPUT_PER_1M=10.0
# Прогонов модели на диалог, ответ по каждому критерию — большинством (стабильнее и воспроизводимее; ~$0.04 за диалог)
SELF_CONSISTENCY=3
